# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_SOLO=price_solo_id
STRIPE_PRICE_TEAM=price_team_id
STRIPE_PRICE_BUSINESS=price_business_id

# API Server
API_PORT=3800
